<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 flex justify-between items-center">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">System Health</h1>
      <%= link_to "Back to Dashboard", root_path, class: "text-sm font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900 mb-4">Current Status</h3>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
          <!-- API Availability -->
          <div class="overflow-hidden rounded-lg bg-gray-50 px-4 py-5 sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">eCFR API Status</dt>
            <dd class="mt-1 flex items-baseline text-2xl font-semibold text-gray-900">
              <% if @api_status == :online %>
                <span class="inline-flex items-center gap-x-1.5 rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">
                  <svg class="h-1.5 w-1.5 fill-green-500" viewBox="0 0 6 6" aria-hidden="true">
                    <circle cx="3" cy="3" r="3" />
                  </svg>
                  Operational
                </span>
              <% else %>
                <span class="inline-flex items-center gap-x-1.5 rounded-md bg-red-100 px-2 py-1 text-xs font-medium text-red-700">
                  <svg class="h-1.5 w-1.5 fill-red-500" viewBox="0 0 6 6" aria-hidden="true">
                    <circle cx="3" cy="3" r="3" />
                  </svg>
                  Offline
                </span>
              <% end %>
            </dd>
          </div>
          
          <!-- Job Queue Depth -->
          <div class="overflow-hidden rounded-lg bg-gray-50 px-4 py-5 sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Job Queue Depth</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
              <%= number_with_delimiter(@queue_depth) %>
            </dd>
            <dd class="mt-2 text-sm text-gray-500">Pending background jobs</dd>
          </div>

          <!-- Last Sync -->
          <div class="overflow-hidden rounded-lg bg-gray-50 px-4 py-5 sm:p-6">
            <dt class="truncate text-sm font-medium text-gray-500">Last Successful Sync</dt>
            <dd class="mt-1 text-lg font-semibold tracking-tight text-gray-900">
              <% if @last_sync %>
                <%= time_ago_in_words(@last_sync.completed_at) %> ago
                <div class="text-xs font-normal text-gray-500 mt-1"><%= @last_sync.completed_at.strftime("%b %d, %H:%M %Z") %></div>
              <% else %>
                <span class="text-gray-400 italic">Never</span>
              <% end %>
            </dd>
          </div>
        </div>
      </div>
    </section>

    <!-- Agency Manual Sync -->
    <section class="mt-8 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900 mb-4">Manual Agency Sync</h3>
        <p class="mb-4 text-sm text-gray-500">Trigger a background sync job for a specific agency.</p>
        
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Agency</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Last Synced</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Sync</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @agencies.each do |agency| %>
                <tr>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                    <%= agency.name %>
                    <span class="ml-2 inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600"><%= agency.acronym %></span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <% if agency.last_synced_at %>
                      <%= time_ago_in_words(agency.last_synced_at) %> ago
                    <% else %>
                      Never
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <%= button_to "Sync Now", sync_agency_path(agency), method: :post, class: "text-indigo-600 hover:text-indigo-900 font-semibold" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
</div>
